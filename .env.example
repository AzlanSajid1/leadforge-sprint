# LeadForge Pipeline Environment Configuration Example
# Copy this file to .env and supply your credentials

# LLM Providers (for Stages 3 & 5)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_backup_api_key_here

# Mailtrap Sandbox (for delivery runner)
MAILTRAP_API_TOKEN=your_mailtrap_token_here
MAILTRAP_INBOX_ID=your_inbox_id_here
